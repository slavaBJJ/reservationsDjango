# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LANGUAGE_CODE=en-us
DJANGO_TIME_ZONE=UTC
DJANGO_DEFAULT_FROM_EMAIL=noreply@scene-ouverte.local

# Production HTTPS/CSRF (indiquer des URL complètes séparées par des virgules)
DJANGO_CSRF_TRUSTED_ORIGINS=https://reservations.example.com
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SAMESITE=Lax
DJANGO_SESSION_COOKIE_SAMESITE=Lax
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_SECURE_PROXY_SSL_HEADER=False

# PostgreSQL
# Sur Render, DATABASE_URL est injectée automatiquement et remplace les
# variables POSTGRES_* ci-dessous.
DATABASE_URL=
POSTGRES_DB=reservations
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-your-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
